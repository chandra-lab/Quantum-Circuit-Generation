exports[`ResultsPanel in Pro mode > renders the same markup as the original results panel 1`] = `
"<section class="panel min-h-[28rem]" aria-live="polite" aria-busy="false"><h2 class="font-serif text-xl text-navy">Results</h2><div class="mt-4 space-y-5"><h3 class="font-serif text-2xl text-ink">Bell State</h3><div class="flex flex-wrap items-center gap-2"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold bg-pine/10 text-pine">Validation passed</span><span class="inline-flex rounded-full bg-copper/10 px-2.5 py-1 text-xs font-semibold text-copper">Predefined reference circuit — not LLM output</span></div><div><h3 class="text-xs font-semibold uppercase tracking-wide text-ink/50">Original prompt</h3><p class="mt-1 text-sm leading-relaxed">Generate a Bell State using two qubits.</p></div><dl class="grid grid-cols-2 gap-3 sm:grid-cols-4"><div class="rounded-lg bg-paper px-3 py-2"><dt class="text-[11px] uppercase tracking-wide text-ink/50">Qubits</dt><dd class="mt-1 font-mono text-sm">2</dd></div><div class="rounded-lg bg-paper px-3 py-2"><dt class="text-[11px] uppercase tracking-wide text-ink/50">Clbits</dt><dd class="mt-1 font-mono text-sm">2</dd></div><div class="rounded-lg bg-paper px-3 py-2"><dt class="text-[11px] uppercase tracking-wide text-ink/50">Shots</dt><dd class="mt-1 font-mono text-sm">1000</dd></div><div class="rounded-lg bg-paper px-3 py-2"><dt class="text-[11px] uppercase tracking-wide text-ink/50">Simulator</dt><dd class="mt-1 font-mono text-sm">qiskit-aer</dd></div></dl><div><h3 class="text-xs font-semibold uppercase tracking-wide text-ink/50">Gates applied</h3><ul class="mt-2 flex flex-wrap gap-2"><li class="rounded-md bg-paper px-2 py-1 font-mono text-xs">H q0</li><li class="rounded-md bg-paper px-2 py-1 font-mono text-xs">CX q0, q1</li></ul></div><p class="text-sm leading-relaxed text-ink/80">Creates an entangled Bell state.</p><figure class="overflow-auto rounded-lg border border-line bg-white p-3"><img src="data:image/svg+xml;charset=utf-8,%3Csvg%3E%3C%2Fsvg%3E" alt="Qiskit circuit diagram with qubit lines, gate symbols, and measurements" class="mx-auto h-auto max-w-full"><figcaption class="mt-2 text-center text-xs text-ink/60">Diagram rendered from the Qiskit circuit that was simulated.</figcaption></figure><div class="grid gap-6 lg:grid-cols-2"><div><h3 class="text-sm font-semibold text-navy">Counts</h3><div class="overflow-x-auto"><svg role="img" aria-label="Measurement histogram" viewBox="0 0 320 190" class="h-48 min-w-full"><g><rect data-testid="bar-00" x="76" y="20" width="28" height="120" rx="3" fill="#1e3a5f"></rect><text x="90" y="14" text-anchor="middle" font-size="11" fill="#1c2430">503</text><text x="90" y="164" text-anchor="middle" font-size="11" fill="#1c2430" font-family="IBM Plex Mono, monospace">00</text></g><g><rect data-testid="bar-11" x="224" y="21.43141153081511" width="28" height="118.56858846918489" rx="3" fill="#1e3a5f"></rect><text x="238" y="15.431411530815112" text-anchor="middle" font-size="11" fill="#1c2430">497</text><text x="238" y="164" text-anchor="middle" font-size="11" fill="#1c2430" font-family="IBM Plex Mono, monospace">11</text></g></svg></div></div><div><h3 class="text-sm font-semibold text-navy">Probabilities</h3><div class="mt-3"><ul class="space-y-3"><li><div class="mb-1 flex items-baseline justify-between gap-3 font-mono text-xs"><span>00</span><span>50.3%</span></div><div class="h-2 rounded-full bg-line" aria-hidden="true"><div class="h-2 rounded-full bg-copper" style="width: 50.3%;"></div></div></li><li><div class="mb-1 flex items-baseline justify-between gap-3 font-mono text-xs"><span>11</span><span>49.7%</span></div><div class="h-2 rounded-full bg-line" aria-hidden="true"><div class="h-2 rounded-full bg-copper" style="width: 49.7%;"></div></div></li></ul></div></div></div><p class="text-xs text-ink/50">Bitstrings use Qiskit order: the rightmost bit is classical bit 0. Probabilities are count divided by shots.</p><div><h3 class="text-xs font-semibold uppercase tracking-wide text-ink/50">Spec JSON</h3><div class="mt-2"><pre class="max-h-80 overflow-auto rounded-lg bg-ink px-4 py-3 font-mono text-xs leading-relaxed text-paper">{
  "circuit_name": "Bell State",
