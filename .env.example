# Copy to .env. Compose reads this file for ${VAR} substitution.
# Never commit a real key. The frontend never receives GROQ_API_KEY.

# Groq API key. Leave empty to simulate predefined reference circuits only.
GROQ_API_KEY=

# A current Groq model that supports JSON schema output. Changeable.
GROQ_MODEL=openai/gpt-oss-20b

# A current Groq model that accepts image input. Reads uploaded images and
# scanned PDF pages. Changeable.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Seconds to wait for one Groq response.
GROQ_TIMEOUT_SECONDS=45

# Hard cap on qubits and classical bits in a spec.
MAX_QUBITS=8

# Upper bound for the shots field. Requests above this are rejected.
MAX_SHOTS=10000

# Shot count used when a request omits shots.
SHOTS=1000

# Attempts to obtain a valid JSON spec from the model, including the first call.
LLM_MAX_RETRIES=3

# Browser origins allowed to call the backend directly.
# The Compose UI is same-origin through nginx, so this matters for Vite on :5173
# and for Swagger or other direct callers.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Maximum HTTP request body size, in bytes.
MAX_REQUEST_BYTES=65536

# Largest image or PDF accepted by POST /api/circuits/generate-from-file, in MB.
# nginx in the frontend container uses the same value. 1 to 14.
MAX_UPLOAD_MB=10

# PDF pages read for text. Later pages are ignored.
MAX_PDF_PAGES=10

# Pages of a scanned PDF (no text layer) rendered for the vision model. 1 to 3.
PDF_VISION_PAGES=3

# Characters of extracted text passed to circuit generation.
MAX_EXTRACTED_CHARS=6000

# Maximum natural-language prompt length.
MAX_PROMPT_CHARS=4000

# Maximum number of gates in one spec.
MAX_GATES=128

# Optional SQLite run history. Generation and simulation continue if this fails.
HISTORY_ENABLED=true
HISTORY_DATABASE_PATH=/tmp/qcg-history.db
