{
  "name": "default",
  "runs_dir": "research/runs",
  "dataset": {
    "seed": 1234,
    "samples_per_class": 300,
    "min_qubits": 1,
    "max_qubits": 8,
    "max_gates": 128,
    "max_padding_gates": 4,
    "path": "research/data/circuits.jsonl"
  },
  "split": {
    "seed": 1234,
    "train": 0.7,
    "val": 0.15,
    "test": 0.15
  },
  "model": {
    "hidden_sizes": [64, 64],
    "dropout": 0.1
  },
  "train": {
    "seed": 1234,
    "epochs": 60,
    "batch_size": 64,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "early_stopping_patience": 10,
    "monitor": "val_macro_f1",
    "device": "cpu",
    "deterministic": true,
    "num_threads": 1
  }
}
